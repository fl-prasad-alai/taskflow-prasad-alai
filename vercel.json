{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.go" },
    { "source": "/auth/(.*)", "destination": "/api/index.go" },
    { "source": "/projects/(.*)", "destination": "/api/index.go" },
    { "source": "/tasks/(.*)", "destination": "/api/index.go" },
    { "source": "/users/(.*)", "destination": "/api/index.go" },
    { "source": "/((?!api/|auth/|projects/|tasks/|users/).*)", "destination": "/index.html" }
  ]
}