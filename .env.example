# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=changeme

# ── Backend ───────────────────────────────────────────────────────────────────
# Full DSN used by the Go server (must match the Postgres vars above)
DATABASE_URL=postgres://taskflow:changeme@db:5432/taskflow?sslmode=disable

# JWT signing secret — use a long random string in production
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-before-deploying

# TCP port the Go API listens on inside its container
PORT=8080

# CORS origin that the API will allow (set to the frontend URL)
CORS_ORIGIN=http://localhost:3000

# ── Seeds (optional) ─────────────────────────────────────────────────────────
# Set to "true" to run seed.sql after migrations on first boot
RUN_SEED=true
